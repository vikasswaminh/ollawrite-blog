---
import type { CollectionEntry } from 'astro:content';
import GithubSlugger from 'github-slugger';
import BaseLayout from './BaseLayout.astro';
import { SITE } from '../config';
import { readingTime } from '../utils/posts';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { title, description, pubDate, updatedDate, author, tags, cover } = post.data;
const minutes = readingTime(post.body);
const canonical = new URL(`/blog/${post.slug}/`, Astro.site).href;

// Extract H2 headings from the markdown body for the table of contents.
const slugger = new GithubSlugger();
const headings = [...post.body.matchAll(/^##\s+(.+)$/gm)].map((m) => {
  const text = m[1].trim();
  const slug = slugger.slug(text);
  return { text, slug };
});

const primaryTag = tags?.[0] ?? 'Insights';
const dateLabel = pubDate.toISOString().slice(0, 10).split('-').reverse().join('-');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Organization', name: author ?? SITE.author },
  publisher: { '@type': 'Organization', name: SITE.brand },
  mainEntityOfPage: canonical,
  ...(cover ? { image: new URL(cover, Astro.site).href } : {}),
};
---

<BaseLayout
  title={title}
  description={description}
  image={cover}
  article={{
    publishedTime: pubDate.toISOString(),
    modifiedTime: (updatedDate ?? pubDate).toISOString(),
    author: author ?? SITE.author,
    tags,
  }}
>
  <article class="post">
    <header class="post-header">
      <p class="post-meta">
        <span class="post-meta-tag">{primaryTag}</span>
        <span aria-hidden="true">•</span>
        <span>{dateLabel}</span>
        <span aria-hidden="true">•</span>
        <span>{minutes} min read</span>
      </p>
      <h1 class="post-title">{title}</h1>
      {description && <p class="post-desc">{description}</p>}
    </header>

    {
      headings.length > 0 && (
        <aside class="toc" aria-label="Table of contents">
          <span class="toc-label">Table of Contents</span>
          <nav class="toc-list">
            {headings.map((h, i) => (
              <a href={`#${h.slug}`}>
                <span class="toc-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="toc-text">{h.text}</span>
              </a>
            ))}
          </nav>
        </aside>
      )
    }

    <div class="post-content">
      {cover && <img class="post-cover" src={cover} alt="" loading="lazy" />}
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
